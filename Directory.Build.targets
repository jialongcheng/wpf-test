<?xml version="1.0" encoding="utf-8"?>
<Project>

  <Import Project="$(WpfArcadeSdkTargets)"
          Condition="Exists('$(WpfArcadeSdkProps)') And Exists('$(WpfArcadeSdkTargets)')"/>

  <Import Sdk="Microsoft.DotNet.Arcade.Wpf.Sdk"
          Project="Sdk.targets"
          Condition="!Exists('$(WpfArcadeSdkProps)') Or !Exists('$(WpfArcadeSdkTargets)')"/>

  <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' and '$(SignAssembly)' != 'false' and '$(PublicSign)' == 'true'">
    <!-- Don't public sign .NETFramework assemblies -->
    <DelaySign>true</DelaySign>
    <PublicSign>false</PublicSign>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
    <PackageReference Include="$(MicrosoftInternalIOPackaging)" Version="$(MicrosoftInternalIOPackagingVersion)"/>
    <PackageReference Include="$(SystemMemoryPackage)" Version="$(SystemMemoryPackageVersion)" />
  </ItemGroup>

  <PropertyGroup>
   <WpfBinDirectory>C:\Test\WPFDeployment\artifacts\bin\</WpfBinDirectory>
  </PropertyGroup>

<!-- Section to inject shared app.config with binding redirects into the output directory and publish directory -->
  <Target Name="InjectAppConfig" AfterTargets="GenerateBindingRedirects" Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
    <ItemGroup>
      <AppConfigWithBindingRedirects Include="$(MSBuildThisFileDirectory)SharedApp.config" />
    </ItemGroup>
    <Copy SourceFiles="@(AppConfigWithBindingRedirects)" DestinationFiles="@(AppConfigWithBindingRedirects->'$(IntermediateOutputPath)$(TargetFileName).config')" />
  </Target>

  <!-- <Target Name="InjectAppConfigBeforePublish" BeforeTargets="_CopyResolvedFilesToPublishPreserveNewest" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <ItemGroup>
      <AppConfigWithBindingRedirects Include="$(MSBuildThisFileDirectory)SharedApp.config" />
    </ItemGroup>
    <Copy
      SourceFiles="@(AppConfigWithBindingRedirects)"
      DestinationFiles="@(AppConfigWithBindingRedirects->'$(IntermediateOutputPath)$(TargetFileName).config')"
      SkipUnchangedFiles="true" />
</Target> -->

<Target Name="CopyAppConfigToOutputAndPublish" AfterTargets="Build" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
  <ItemGroup>
    <AppConfigWithBindingRedirects Include="$(MSBuildThisFileDirectory)SharedApp.config" />
  </ItemGroup>
  <!-- Copy to OurDir -->
  <Copy
    SourceFiles="@(AppConfigWithBindingRedirects)"
    DestinationFiles="@(AppConfigWithBindingRedirects->'$(OutDir)$(TargetFileName).config')"
    SkipUnchangedFiles="false"
    OverwriteReadOnlyFiles="true" />

  <!-- Copy to PublishDir -->
  <Copy
    SourceFiles="@(AppConfigWithBindingRedirects)"
    DestinationFiles="@(AppConfigWithBindingRedirects->'$(PublishDir)$(TargetFileName).config')"
    SkipUnchangedFiles="true"
    OverwriteReadOnlyFiles="true" />
</Target>

<!-- Disable the following target to avoid double copying-->
<!-- <Target Name="GenerateBindingRedirectsUpdateAppConfig" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'"/> -->
<!-- <Target Name="_WriteAppConfigWithSupportedRuntime" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'"/> -->

  <Target Name="InjectWpfgfxLoader"
          BeforeTargets="Compile"
          Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
    <ItemGroup>
      <Compile Include="$(MSBuildThisFileDirectory)build\shared\InjectWpfgfxLoader.cs" />
    </ItemGroup>
  </Target>

