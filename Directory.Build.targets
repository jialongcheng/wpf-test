<Target Name="RemoveGacUIAutomationTypes" AfterTargets="ResolveAssemblyReferences" Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
  <ItemGroup>
    <ReferencePath Remove="@(ReferencePath)" Condition="'%(ReferencePath.FusionName)' == 'UIAutomationTypes, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35'" />
  </ItemGroup>
</Target>

<Target Name="RemoveGacUIAutomationClient" BeforeTargets="ResolveAssemblyReferences" Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
  <ItemGroup>
    <ReferencePath Remove="@(ReferencePath)" Condition="'%(ReferencePath.FusionName)' == 'UIAutomationClient, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35'" />
  </ItemGroup>
</Target>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
    <Reference Include="Accessibility" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />

    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Security" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />

    <Reference Include="PresentationCore">
      <HintPath>$(WpfBinDirectory)PresentationCore\$(Platform)\Release\net481\PresentationCore.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationFramework">
      <HintPath>$(WpfBinDirectory)PresentationFramework\$(Platform)\Release\net481\PresentationFramework.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationFramework-SystemCore">
      <HintPath>$(WpfBinDirectory)PresentationFramework-SystemCore\$(Platform)\Release\net481\PresentationFramework-SystemCore.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationFramework-SystemData">
      <HintPath>$(WpfBinDirectory)PresentationFramework-SystemData\$(Platform)\Release\net481\PresentationFramework-SystemData.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationFramework-SystemDrawing">
      <HintPath>$(WpfBinDirectory)PresentationFramework-SystemDrawing\$(Platform)\Release\net481\PresentationFramework-SystemDrawing.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationFramework-SystemXml">
      <HintPath>$(WpfBinDirectory)PresentationFramework-SystemXml\$(Platform)\Release\net481\PresentationFramework-SystemXml.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationFramework-SystemXmlLinq">
      <HintPath>$(WpfBinDirectory)PresentationFramework-SystemXmlLinq\$(Platform)\Release\net481\PresentationFramework-SystemXmlLinq.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationFramework.Aero">
      <HintPath>$(WpfBinDirectory)PresentationFramework.Aero\$(Platform)\Release\net481\PresentationFramework.Aero.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationFramework.Aero2">
      <HintPath>$(WpfBinDirectory)PresentationFramework.Aero2\$(Platform)\Release\net481\PresentationFramework.Aero2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationFramework.AeroLite">
      <HintPath>$(WpfBinDirectory)PresentationFramework.AeroLite\$(Platform)\Release\net481\PresentationFramework.AeroLite.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationFramework.Classic">
      <HintPath>$(WpfBinDirectory)PresentationFramework.Classic\$(Platform)\Release\net481\PresentationFramework.Classic.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationFramework.Luna">
      <HintPath>$(WpfBinDirectory)PresentationFramework.Luna\$(Platform)\Release\net481\PresentationFramework.Luna.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationFramework.Royale">
      <HintPath>$(WpfBinDirectory)PresentationFramework.Royale\$(Platform)\Release\net481\PresentationFramework.Royale.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PresentationUI">
      <HintPath>$(WpfBinDirectory)PresentationUI\$(Platform)\Release\net481\PresentationUI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ReachFramework">
      <HintPath>$(WpfBinDirectory)ReachFramework\$(Platform)\Release\net481\ReachFramework.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Printing">
      <HintPath>$(WpfBinDirectory)System.Printing\$(Platform)\Release\net481\System.Printing.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Windows.Controls.Ribbon">
      <HintPath>$(WpfBinDirectory)System.Windows.Controls.Ribbon\$(Platform)\Release\net481\System.Windows.Controls.Ribbon.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Windows.Input.Manipulations">
      <HintPath>$(WpfBinDirectory)System.Windows.Input.Manipulations\$(Platform)\Release\net481\System.Windows.Input.Manipulations.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Windows.Presentation">
      <HintPath>$(WpfBinDirectory)System.Windows.Presentation\$(Platform)\Release\net481\System.Windows.Presentation.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Xaml">
      <HintPath>$(WpfBinDirectory)System.Xaml\$(Platform)\Release\net481\System.Xaml.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UIAutomationClient">
      <HintPath>$(WpfBinDirectory)UIAutomationClient\$(Platform)\Release\net481\UIAutomationClient.dll</HintPath>
      <Private>true</Private>
      <SpecificVersion>true</SpecificVersion>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="UIAutomationClientSideProviders">
      <HintPath>$(WpfBinDirectory)UIAutomationClientSideProviders\$(Platform)\Release\net481\UIAutomationClientSideProviders.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UIAutomationProvider">
      <HintPath>$(WpfBinDirectory)UIAutomationProvider\$(Platform)\Release\net481\UIAutomationProvider.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UIAutomationTypes">
      <HintPath>$(WpfBinDirectory)UIAutomationTypes\$(Platform)\Release\net481\UIAutomationTypes.dll</HintPath>
      <Private>true</Private>
      <SpecificVersion>true</SpecificVersion>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="WindowsBase">
      <HintPath>$(WpfBinDirectory)WindowsBase\$(Platform)\Release\net481\WindowsBase.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="WindowsFormsIntegration">
      <HintPath>$(WpfBinDirectory)WindowsFormsIntegration\$(Platform)\Release\net481\WindowsFormsIntegration.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
<!-- 
  <Target Name="ForceUIAutomationTypesIntoMarkupCompile" BeforeTargets="MarkupCompilePass1" Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
  <ItemGroup>
    <MarkupCompilePass1AdditionalLibPaths Include="$(OutDir)" />
  </ItemGroup>
  </Target> -->

<Target Name="CopyUIAutomationTypesToIntermediate" BeforeTargets="MarkupCompilePass1" Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
  <Copy
    SourceFiles="$(WpfBinDirectory)UIAutomationTypes\$(Platform)\Release\net481\UIAutomationTypes.dll"
    DestinationFolder="$(IntermediateOutputPath)" />
</Target>

<Target Name="ForceUIAutomationTypesIntoMarkupCompile" BeforeTargets="MarkupCompilePass1" Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
  <ItemGroup>
    <MarkupCompilePass1AdditionalLibPaths Include="$(OutDir)" />
    <MarkupCompilePass1AdditionalLibPaths Include="$(IntermediateOutputPath)" />
  </ItemGroup>
</Target>


  <!-- <Target Name="ForceUIAutomationTypesIntoMarkupCompile" BeforeTargets="MarkupCompilePass1" Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
  <ItemGroup>
    <MarkupCompilePass1AdditionalLibPaths Include="$(WpfBinDirectory)UIAutomationTypes\$(Platform)\Release\net481" />
  </ItemGroup>
</Target> -->



  <Target Name="InjectUIAutomationTypesReferencePath" BeforeTargets="MarkupCompilePass1" Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
    <ItemGroup>
      <ReferencePath Include="$(OutDir)UIAutomationTypes.dll" />
    </ItemGroup>
  </Target>

  <Target Name="CopyUIAutomationTypesEarly" BeforeTargets="MarkupCompilePass1" Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
    <ItemGroup>
      <WpfBinDirectory Include="$(WpfBinDirectory)" />
    </ItemGroup>
    <Copy
      SourceFiles="$(WpfBinDirectory)UIAutomationTypes\$(Platform)\Release\net481\UIAutomationTypes.dll"
      DestinationFolder="$(OutDir)" />
</Target>


  <Target Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'" Name="AliasNetFxReferences" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePath Include="@(ReferencePath->WithMetadataValue('FileName', 'System'))" Aliases="System" />
    </ItemGroup>
  </Target>

  <!-- <Import Project="AppLocalWPF.targets" Condition="Exists('AppLocalWPF.targets')" /> -->

</Project>
