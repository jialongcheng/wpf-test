<?xml version="1.0" encoding="utf-8"?>
<Project>

  <Import Project="$(WpfArcadeSdkTargets)"
          Condition="Exists('$(WpfArcadeSdkProps)') And Exists('$(WpfArcadeSdkTargets)')"/>

  <Import Sdk="Microsoft.DotNet.Arcade.Wpf.Sdk"
          Project="Sdk.targets"
          Condition="!Exists('$(WpfArcadeSdkProps)') Or !Exists('$(WpfArcadeSdkTargets)')"/>

  <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' and '$(SignAssembly)' != 'false' and '$(PublicSign)' == 'true'">
    <!-- Don't public sign .NETFramework assemblies -->
    <DelaySign>true</DelaySign>
    <PublicSign>false</PublicSign>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
    <PackageReference Include="$(MicrosoftInternalIOPackaging)" Version="$(MicrosoftInternalIOPackagingVersion)"/>
    <PackageReference Include="$(SystemMemoryPackage)" Version="$(SystemMemoryPackageVersion)" />
  </ItemGroup>

  <PropertyGroup>
   <WpfBinDirectory>C:\Test\WPFDeployment\artifacts\bin\</WpfBinDirectory>
  </PropertyGroup>

  <Target Name="InjectAppConfig" AfterTargets="GenerateBindingRedirects" Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
    <ItemGroup>
      <AppConfigWithBindingRedirects Include="$(MSBuildThisFileDirectory)SharedApp.config" />
    </ItemGroup>
    <Copy SourceFiles="@(AppConfigWithBindingRedirects)" DestinationFiles="@(AppConfigWithBindingRedirects->'$(IntermediateOutputPath)$(TargetFileName).config')" />
  </Target>

  <Target Name="InjectWpfgfxLoader"
          BeforeTargets="Compile"
          Condition="'$(OutputType)' == 'Exe'">
    <ItemGroup>
      <Compile Include="$(MSBuildThisFileDirectory)build\shared\InjectWpfgfxLoader.cs" />
    </ItemGroup>
  </Target>

  <!-- <ItemGroup>
    <Reference Remove="PresentationCore" />
    <Reference Remove="PresentationFramework" />
    <Reference Remove="PresentationFramework-SystemCore" />
    <Reference Remove="PresentationFramework-SystemData" />
    <Reference Remove="PresentationFramework-SystemDrawing" />
    <Reference Remove="PresentationFramework-SystemXml" />
    <Reference Remove="PresentationFramework-SystemXmlLinq" />
    <Reference Remove="PresentationFramework.Aero" />
    <Reference Remove="PresentationFramework.Aero2" />
    <Reference Remove="PresentationFramework.AeroLite" />
    <Reference Remove="PresentationFramework.Classic" />
    <Reference Remove="PresentationFramework.Luna" />
    <Reference Remove="PresentationFramework.Royale" />
    <Reference Remove="PresentationUI" />
    <Reference Remove="ReachFramework" />
    <Reference Remove="System.Printing" />
    <Reference Remove="System.Windows.Controls.Ribbon" />
    <Reference Remove="System.Windows.Input.Manipulations" />
    <Reference Remove="System.Windows.Presentation" />
