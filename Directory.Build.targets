<Target Name="RemoveGacUIAutomationTypes" BeforeTargets="ResolveAssemblyReferences" Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
  <ItemGroup>
    <ReferencePath Remove="@(ReferencePath)" Condition="'%(ReferencePath.FusionName)' == 'UIAutomationTypes, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35'" />
  </ItemGroup>
</Target>

<Target Name="RemoveGacUIAutomationClient" BeforeTargets="ResolveAssemblyReferences" Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework'">
  <ItemGroup>
    <ReferencePath Remove="@(ReferencePath)" Condition="'%(ReferencePath.FusionName)' == 'UIAutomationClient, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35'" />
  </ItemGroup>
</Target>

<Target Name="ForceCopyUIAutomationTypes" AfterTargets="Build" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
  <Copy
    SourceFiles="$(WpfBinDirectory)UIAutomationTypes\$(Platform)\Release\net481\UIAutomationTypes.dll"
    DestinationFolder="$(OutputPath)"
    SkipUnchangedFiles="true" />
</Target>

<Target Name="ForceCopyUIAutomationClient" AfterTargets="Build" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
  <Copy
    SourceFiles="$(WpfBinDirectory)UIAutomationClient\$(Platform)\Release\net481\UIAutomationClient.dll"
    DestinationFolder="$(OutputPath)"
    SkipUnchangedFiles="true" />
</Target>


